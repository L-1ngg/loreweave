# Versioned, non-secret RAG behavior. The CLI --config option overrides this.
RAG_CONFIG_PATH=config/rag.yaml

# PostgreSQL business source of truth
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
RAG_POSTGRES_PORT=5432

# Elasticsearch projection: Docker development defaults
RAG_ELASTICSEARCH_URL=http://localhost:9200
# Override the compose host port when another local stack owns 9200.
RAG_ELASTICSEARCH_PORT=9200
RAG_ELASTICSEARCH_API_KEY=
RAG_ELASTICSEARCH_USERNAME=
RAG_ELASTICSEARCH_PASSWORD=
RAG_ELASTICSEARCH_VERIFY_CERTS=true
RAG_ELASTICSEARCH_INDEX_PREFIX=rag

# MinIO/S3: Docker development defaults
RAG_S3_ENDPOINT_URL=http://localhost:9000
RAG_MINIO_PORT=9000
RAG_MINIO_CONSOLE_PORT=9001
# Hostname that the remote MinerU service can reach. Do not leave this as
# localhost when using the official remote API; for cloud S3 it may be blank.
RAG_S3_PUBLIC_ENDPOINT_URL=
RAG_S3_REGION=us-east-1
RAG_S3_BUCKET=my-rag
RAG_S3_ACCESS_KEY=minioadmin
RAG_S3_SECRET_KEY=minioadmin
RAG_S3_PRESIGN_EXPIRY_SECONDS=3600

# MinerU official remote API
RAG_MINERU_BASE_URL=https://mineru.net
RAG_MINERU_API_TOKEN=
# url: MinerU pulls the source from a presigned URL; requires a public
#   RAG_S3_PUBLIC_ENDPOINT_URL (or cloud S3).
# upload: the service pushes file bytes to MinerU; object storage stays
#   private, so local MinIO works without a tunnel.
RAG_MINERU_SUBMISSION_MODE=url
RAG_MINERU_POLL_INTERVAL_SECONDS=3
RAG_MINERU_MAX_WAIT_SECONDS=1800
RAG_MINERU_REQUEST_TIMEOUT_SECONDS=60
RAG_MINERU_MAX_RESULT_BYTES=536870912

# OpenAI-compatible cloud embedding API
RAG_EMBEDDING_BASE_URL=https://api.example.com/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BATCH_SIZE=32

# OpenAI-compatible chat API, separate from embeddings. Used only for write-time
# enrichment and restricted multi-turn reference resolution.
RAG_CHAT_BASE_URL=https://api.example.com/v1
RAG_CHAT_API_KEY=
RAG_CHAT_TIMEOUT_SECONDS=60
RAG_CHAT_CONCURRENCY=4

# Online answer generation. Keep this separate from write-time enrichment and
# restricted reference resolution; it may point to the same endpoint/model.
RAG_GENERATION_BASE_URL=https://api.example.com/v1
RAG_GENERATION_API_KEY=
RAG_GENERATION_TIMEOUT_SECONDS=60
RAG_GENERATION_CONCURRENCY=4

# Offline Ragas judge. Kept separate from production chat/enrichment settings.
RAG_EVAL_BASE_URL=https://api.example.com/v1
RAG_EVAL_API_KEY=
RAG_EVAL_TIMEOUT_SECONDS=60
RAG_EVAL_CONCURRENCY=2

# Cross-encoder reranker (Jina/TEI-compatible /rerank endpoint), required only
# when retrieval_profile.rerank.enabled is true.
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT_SECONDS=30

# Optional ISO-8601 value for deterministic relative-time evaluation/tests.
RAG_RELATIVE_BASE=

# Transactional outbox worker
RAG_WORKER_ID=rag-worker
RAG_OUTBOX_LEASE_SECONDS=60
RAG_OUTBOX_POLL_SECONDS=1

# MCP
RAG_MCP_HOST=127.0.0.1
RAG_MCP_PORT=8000
RAG_MCP_PUBLISHED_PORT=18080
RAG_MCP_BEARER_TOKEN=
RAG_MCP_PUBLIC_BASE_URL=

# Optional Docker Compose application image name
RAG_APP_IMAGE=my-rag:local
