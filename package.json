{
  "name": "loreweave",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun --no-env-file scripts/setup.ts",
    "db:migrate": "bun --no-env-file scripts/migrate.ts",
    "fixtures:generate": "bun --no-env-file scripts/generate-fixtures.ts",
    "fixtures:verify": "bun --no-env-file scripts/verify-fixtures.ts",
    "eval:reference": "bun --no-env-file scripts/compare-reference.ts",
    "eval:extraction": "bun --no-env-file scripts/evaluate-extraction.ts",
    "eval:flash-candidate": "bun --no-env-file scripts/evaluate-flash.ts",
    "eval:real": "bun --no-env-file scripts/evaluate-real.ts",
    "eval:full-reference": "bun --no-env-file scripts/evaluate-full-reference.ts",
    "eval:compare": "bun --no-env-file scripts/compare-evaluation.ts",
    "eval:report": "bun --no-env-file scripts/report-evaluation.ts",
    "dev": "bun --no-env-file scripts/dev.ts",
    "build": "bun --no-env-file node_modules/vite/bin/vite.js build",
    "start": "bun --no-env-file scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --no-env-file test tests/*.test.ts",
    "test:conformance": "bun --no-env-file scripts/conformance.ts",
    "test:browser": "bun --no-env-file node_modules/@playwright/test/cli.js test",
    "check:docs": "bun --no-env-file scripts/check-docs.ts",
    "check:baseline": "bun --no-env-file scripts/probe-baseline.ts",
    "format": "prettier --write src scripts tests docs README.md CONTRIBUTING.md CONTEXT.md AGENTS.md NOTICE.md package.json tsconfig.json vite.config.ts playwright.config.ts .github/workflows/ci.yml",
    "format:check": "prettier --check src scripts tests docs README.md CONTRIBUTING.md CONTEXT.md AGENTS.md NOTICE.md package.json tsconfig.json vite.config.ts playwright.config.ts .github/workflows/ci.yml",
    "intent:list": "bun --no-env-file node_modules/@tanstack/intent/dist/cli.mjs list",
    "intent:load": "bun --no-env-file node_modules/@tanstack/intent/dist/cli.mjs load"
  },
  "dependencies": {
    "@tanstack/ai": "0.63.0",
    "@tanstack/ai-mcp": "0.6.0",
    "@tanstack/ai-openai": "0.25.1",
    "@tanstack/ai-persistence": "0.7.1",
    "@tanstack/ai-react": "0.29.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.577.0",
    "markdown-it": "15.0.1",
    "pdfjs-dist": "6.3.289",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.63.0",
    "@tanstack/intent": "0.5.0",
    "@types/bun": "1.3.12",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "github-slugger": "2.0.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/start-client-core",
      "@tanstack/ai",
      "@tanstack/ai-persistence",
      "@tanstack/ai-mcp"
    ]
  }
}
