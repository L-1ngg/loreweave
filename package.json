{
  "name": "loreweave",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "vendor/forge-agent/packages/*"
  ],
  "scripts": {
    "test": "bun test tests/host.test.ts tests/http.test.ts tests/sdk-admission.test.ts tests/markdown.test.ts",
    "typecheck": "tsc --noEmit",
    "check:docs": "bun scripts/check-docs.mjs",
    "dev": "bun --no-env-file scripts/dev.mjs",
    "build": "vite build",
    "test:browser": "playwright test",
    "check:vendor": "bun scripts/check-vendor.mjs",
    "format:check": "prettier --check src tests web scripts vite.config.ts playwright.config.ts tsconfig.json package.json .github/workflows/ci.yml compose.yaml migrations/meta/_journal.json",
    "format": "prettier --write src tests web scripts vite.config.ts playwright.config.ts tsconfig.json package.json .github/workflows/ci.yml compose.yaml migrations/meta/_journal.json",
    "test:upstream": "bun test vendor/forge-agent/packages/core/test/sdk.test.ts vendor/forge-agent/packages/core/test/sdk-integration.test.ts vendor/forge-agent/packages/core/test/runtime-tools.test.ts vendor/forge-agent/packages/core/test/incremental-session.test.ts vendor/forge-agent/packages/core/test/input-ownership.test.ts vendor/forge-agent/packages/core/test/runtime-retry.test.ts",
    "test:persistence": "bun --no-env-file test tests/persistence.test.ts",
    "reconcile:run": "bun --no-env-file scripts/reconcile-run.ts",
    "bootstrap:admin": "bun --no-env-file scripts/bootstrap-admin.ts",
    "test:access": "bun --no-env-file test tests/access.test.ts",
    "test:sources": "bun --no-env-file test tests/sources.test.ts",
    "test:evidence": "bun --no-env-file test tests/evidence.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@forge-agent/core": "workspace:*",
    "@forge-agent/protocol": "workspace:*",
    "@node-rs/jieba": "2.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "markdown-it": "15.0.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.12",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.85.1": "vendor/forge-agent/patches/@earendil-works%2Fpi-ai@0.85.1.patch"
  }
}
