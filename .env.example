# Copy to .env for local development. Keep secrets out of Git.
DATABASE_URL=postgres://loreweave:loreweave_local@127.0.0.1:45432/loreweave
LOREWEAVE_PROVIDER_MODE=scripted
LOREWEAVE_ORGANIZATION=local
LOREWEAVE_BOOTSTRAP_USERNAME=admin
LOREWEAVE_BOOTSTRAP_PASSWORD=
LOREWEAVE_RETRIEVAL_PROFILE=source

# Required only for dev:real and smoke:providers.
RAG_CHAT_BASE_URL=https://example.invalid/v1
RAG_CHAT_API_KEY=
RAG_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
LOREWEAVE_CHAT_PROVIDER=huggingface
RAG_CHAT_TIMEOUT_SECONDS=45
RAG_EMBEDDING_BASE_URL=https://example.invalid/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_SEND_DIMENSIONS=false
RAG_EMBEDDING_BATCH_SIZE=16

# Optional evaluation credentials.
LOREWEAVE_EVAL_TOKEN=
LOREWEAVE_UPDATE_TOKEN=
LOREWEAVE_EVAL_PROVENANCE=controlled-provider
